# Offline demo: no calls to the gateway and no automatic dump import.
POSTGRES_PASSWORD=sicamp
SEED_DEMO=true
LLM_PROVIDER=demo
LLM_BASE_URL=https://llm-gateway.sicamp.ru/v1
LLM_API_KEY=
LLM_MODEL=nebius/deepseek-ai/DeepSeek-V4-Pro
LLM_TIMEOUT=180
LLM_MAX_TOKENS=12000

# Semantic mode requires an embeddings API; the supplied GATE docs list only chat.
# In local mode a deterministic lexical hash baseline is used.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
