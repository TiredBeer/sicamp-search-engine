# No automatic dump import. With a key, auto enables the real LLM.
POSTGRES_PASSWORD=sicamp
SEED_DEMO=true
LLM_PROVIDER=auto
LLM_BASE_URL=https://llm-gateway.sicamp.ru/v1
LLM_API_KEY=
LLM_MODEL=nebius/Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_TIMEOUT=180
LLM_MAX_TOKENS=12000

# CPU semantic embeddings, downloaded once and cached in a Docker volume.
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_THREADS=2
# Optional separate embeddings API. GATE currently rejects /embeddings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
